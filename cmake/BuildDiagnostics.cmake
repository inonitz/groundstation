cmake_minimum_required(VERSION 3.24)

macro(set_default_flag VAR VAL)
    if(NOT DEFINED ${VAR})
        set(${VAR} ${VAL} CACHE BOOL "")
    endif()
endmacro()

macro(print_all_workspace_flags_and_vars)
    message(STATUS "--- Workspace Configuration (Begin) ---")
    message(STATUS "GROUNDSTATION_FORCE_COLOURED_OUTPUT:         ${GROUNDSTATION_FORCE_COLOURED_OUTPUT}")
    message(STATUS "GROUNDSTATION_ENABLE_SANITIZER_ADDRESS:      ${GROUNDSTATION_ENABLE_SANITIZER_ADDRESS}")
    message(STATUS "GROUNDSTATION_ENABLE_SANITIZER_UNDEFINED:    ${GROUNDSTATION_ENABLE_SANITIZER_UNDEFINED}")
    message(STATUS "GROUNDSTATION_ENABLE_SANITIZER_MEMORY:       ${GROUNDSTATION_ENABLE_SANITIZER_MEMORY}")
    message(STATUS "GROUNDSTATION_ENABLE_LINK_TIME_OPTIMIZATION: ${GROUNDSTATION_ENABLE_LINK_TIME_OPTIMIZATION}")
    message(STATUS "GROUNDSTATION_BUILD_EXECUTABLE:              ${GROUNDSTATION_BUILD_EXECUTABLE}")
    message(STATUS "GROUNDSTATION_BUILD_TESTS:                   ${GROUNDSTATION_BUILD_TESTS}")
    message(STATUS "GROUNDSTATION_BUILD_BENCHMARKS:              ${GROUNDSTATION_BUILD_BENCHMARKS}")
    message(STATUS "---------------------------------------")
    message(STATUS "--- Workspace Configuration ( End ) ---")
endmacro()