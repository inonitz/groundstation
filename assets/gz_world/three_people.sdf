<sdf version="1.6">
  <world name="three_people">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0.0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>.4 .4 .4</ambient>
      <sky></sky>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Multi-person SITL scene for the stable-id tracker + SEARCH/APPROACH/FOLLOW
         demo. Three "person" actors so the tracker must hold three distinct ids at
         once and never swap them. All three use the same person_walking mesh, so
         (as in the plan) they are IDENTICAL in appearance (geometry, not looks,
         is what tells them apart in SITL). The drone spawns at (0,7,3) facing +X
         (yaw 0), so it looks down +X with lateral axis +y=left. The three actors
         sit ~5 m ahead in three SEPARATED lateral lanes, so their boxes never
         overlap and the ids stay pinned:

             right lane  y=3.5..5.5   (drone's right)
             target lane y=6.5..7.5   (dead centre, the follow target)
             left  lane  y=8.0..10.0  (drone's left)

         Lane gaps are ~1 m at 5 m range, so clearly separate boxes. The centre one
         is "the target": it stays near frame centre and barely paces, so a plain
         "follow the person in the middle" instruction resolves to it, and its
         track_id is the one FOLLOW should pin. Its mesh visual is tinted red as a
         cheap eyeball marker (if the renderer honours the override; positions
         distinguish them regardless). Distractors sweep wider so you can watch
         their ids stay put while they move. -->

    <!-- TARGET: centre, subtle pace, red-tinted. -->
    <actor name="person_target">
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://person_walking/meshes/walking.dae</uri></mesh>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>0.0</delay_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>5 6.5 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>5</time><pose>5 7.5 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>6</time><pose>5 7.5 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>11</time><pose>5 6.5 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>12</time><pose>5 6.5 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- DISTRACTOR LEFT: wide sweep on the drone's left. -->
    <actor name="person_left">
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://person_walking/meshes/walking.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>0.0</delay_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>4.5 8.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>6</time><pose>4.5 10.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>7</time><pose>4.5 10.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>13</time><pose>4.5 8.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>14</time><pose>4.5 8.0 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- DISTRACTOR RIGHT: wide sweep on the drone's right, out of phase. -->
    <actor name="person_right">
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh><uri>model://person_walking/meshes/walking.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <delay_start>3.0</delay_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>4.5 5.5 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>6</time><pose>4.5 3.5 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>7</time><pose>4.5 3.5 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>13</time><pose>4.5 5.5 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>14</time><pose>4.5 5.5 0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
