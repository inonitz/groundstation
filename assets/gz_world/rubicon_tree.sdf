<sdf version="1.6">
  <world name="rubicon_tree">

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0.0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>.4 .4 .4</ambient>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <name>Rubicon</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rubicon</uri>
    </include>

    <!-- DEMO 1: colour-disambiguated FOLLOW. Three people as STATIC MODELS (NOT gz-classic
         actors, which gz-sim/Harmonic does not render). All three use the person_walking
         mesh, so YOLO labels each "person"; only the centre one is recoloured RED, so the
         VLM can disambiguate ("find the person in red and follow them in place") and FOLLOW
         pins its track. Static so they stand still (the drone follows in place).

         Placement: real coordinates in the Rubicon tree cluster (measured on the terrain,
         hence the varying z heights). Drone spawns at 0,7,3 facing +X; the group is ahead
         and slightly left, each on its local ground height. RED (person_red) is the follow
         target; person_left / person_right are the distractors. -->

    <!-- TARGET: centre, RED (inline model so the mesh visual carries a red material). -->
    <model name="person_red">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>model://person_walking/meshes/walking.dae</uri></mesh></geometry>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://person_walking/meshes/walking.dae</uri></mesh></geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <pose>12 11.5 1.5 0 0 3.14159</pose>
    </model>

    <!-- DISTRACTOR LEFT: default colour. -->
    <include>
      <name>person_left</name>
      <uri>model://person_walking</uri>
      <static>true</static>
      <pose>16 8.5 3 0 0 3.14159</pose>
    </include>

    <!-- DISTRACTOR RIGHT: default colour. -->
    <include>
      <name>person_right</name>
      <uri>model://person_walking</uri>
      <static>true</static>
      <pose>13 10 1.5 0 0 3.14159</pose>
    </include>

  </world>
</sdf>
